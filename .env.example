# Cadena de conexión que te da Railway para el servicio de Postgres
DATABASE_URL=postgres://user:password@host:5432/railway

# Generar con: openssl rand -base64 48
JWT_SECRET=

PORT=3000

# Access token de la cuenta de Mercado Pago del negocio (o de una
# cuenta de prueba en sandbox). Panel de MP > Tus integraciones.
MERCADOPAGO_ACCESS_TOKEN=

# La Orders API (POST /v1/orders) no toma notification_url por
# request como la vieja /checkout/preferences — el webhook se registra
# una sola vez en el panel de MP (Tus integraciones > Webhooks), no
# hace falta esta variable en runtime. Se deja documentada acá porque
# es la URL que hay que pegar en ese panel:
# https://<dominio-del-servicio>/payments/webhook/mercadopago
MERCADOPAGO_WEBHOOK_URL=

# Secret que Mercado Pago genera al configurar el webhook (no se
# elige, lo da su panel). Se usa para verificar la firma x-signature
# de cada notificación antes de confiar en su contenido.
MERCADOPAGO_WEBHOOK_SECRET=

# WhatsApp Cloud API de Meta (Meta for Developers > tu app > WhatsApp >
# Configuración de la API). El access token tiene que ser el permanente
# (usuario del sistema en Business Settings, expiración "Nunca") — el
# temporal de 24hs que da esta pantalla por default expira solo.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Clave secreta de la app (Meta for Developers > tu app > Configuración
# básica > "Clave secreta"). Verifica que los webhooks entrantes de
# WhatsApp (mensajes de clientes) sean realmente de Meta, vía
# X-Hub-Signature-256 sobre el body crudo del request.
WHATSAPP_APP_SECRET=

# String cualquiera que vos elijas (no lo da Meta) — se pega también en
# el panel de configuración del webhook al registrar la URL. Meta lo
# manda de vuelta en el handshake inicial (GET) para confirmar que sos
# dueño de la URL antes de empezar a mandar mensajes reales.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# API key de Anthropic (console.anthropic.com) — el bot de WhatsApp la
# usa para interpretar la pregunta del cliente y redactar la respuesta,
# siempre a partir de los datos reales del club que le pasamos
# (canchas, horarios), nunca inventados.
ANTHROPIC_API_KEY=

# URL pública del frontend (canchaya-web) sin barra final — el bot la
# usa para mandar el link de reservas de cada club (WEB_APP_URL/slug).
WEB_APP_URL=https://canchaya-web-nine.vercel.app
